# ───────────── OS / editor ─────────────
.DS_Store
*.swp
*~
Thumbs.db

# ───────────── Node (admin-panel, functions) ─────────────
node_modules/
dist/
build/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.vite/
# tsc -b (admin-panel build) incremental cache + emitted vite config
*.tsbuildinfo
admin-panel/vite.config.js
admin-panel/vite.config.d.ts

# Environment files (keep .env.example committed)
.env
.env.*
!.env.example

# ───────────── Firebase ─────────────
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
.runtimeconfig.json
functions/lib/

# Service-account / credential keys (never commit)
**/serviceAccount*.json
**/*-firebase-adminsdk-*.json
*.pem

# ───────────── Flutter / Dart (kafi_app) ─────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
**/build/
*.iml
.idea/

# Flutter platform build artifacts
**/android/.gradle/
**/android/app/debug/
**/android/app/profile/
**/android/app/release/
**/android/local.properties
**/android/key.properties
**/android/**/*.keystore
**/android/**/*.jks
**/ios/Pods/
**/ios/.symlinks/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/Generated.xcconfig
**/macos/Pods/
**/macos/Flutter/ephemeral/
**/linux/flutter/ephemeral/
**/windows/flutter/ephemeral/

# Mobile secrets (managed outside the repo)
**/google-services.json
**/GoogleService-Info.plist

# ───────────── FVM (Flutter version manager) ─────────────
# Keep .fvmrc and .fvm/fvm_config.json; ignore the downloaded SDK.
.fvm/flutter_sdk
.fvm/versions/
.fvm/release
.fvm/version

# Deploy service account materialized by scripts/materialize-secrets.sh (never commit)
scripts/service-account.json

# Claude Code agent git worktrees (each is its own working tree, never repo content)
.claude/worktrees/
