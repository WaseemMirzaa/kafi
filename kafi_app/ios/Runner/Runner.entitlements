<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Xcode rewrites this to development for Debug / flutter-run installs.
	     App Store / TestFlight keep production. Firebase Auth APNs type is
	     set to `.unknown` in AppDelegate so sandbox vs prod is auto-detected. -->
	<key>aps-environment</key>
	<string>production</string>
</dict>
</plist>
