<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- production covers both App Store and TestFlight (internal + external).
	     Debug builds on simulator/device still work — APNs sandbox is used
	     automatically when the device runs a development-signed build. -->
	<key>aps-environment</key>
	<string>production</string>
	<key>keychain-access-groups</key>
	<array/>
</dict>
</plist>
