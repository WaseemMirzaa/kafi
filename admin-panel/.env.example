VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Optional override for the bootstrap Cloud Function URL.
# VITE_BOOTSTRAP_ADMIN_URL=https://us-central1-yhgc-testing.cloudfunctions.net/bootstrapFirstAdmin

# Set to false to use the live Firebase backend (real login, approvals, blocks).
# When unset it defaults to mock in `vite dev` and live in production builds.
VITE_USE_MOCK=false
